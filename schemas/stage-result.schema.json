{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/naver-blog/stage-result.schema.json",
  "type": "object",
  "required": [
    "stage",
    "status",
    "execution",
    "artifacts",
    "message",
    "resolved_keyword",
    "run_status"
  ],
  "properties": {
    "stage": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "status": { "enum": ["passed", "validated", "failed", "blocked"] },
    "execution": { "enum": ["produced", "validated", "attempted"] },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "items": { "type": "string", "minLength": 1 }
    },
    "message": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "resolved_keyword": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "run_status": {
      "anyOf": [
        { "enum": ["ready_for_naver", "awaiting_user_confirmation", "draft_saved"] },
        { "type": "null" }
      ]
    }
  },
  "additionalProperties": false
}
