{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/naver-blog/workflow-contract.schema.json",
  "title": "Naver Blog Workflow Optimized v1 Contract",
  "description": "Single contract for stages, visual slots, image generation metadata, and canonical manifests.",
  "oneOf": [
    { "$ref": "#/$defs/stageEvent" },
    { "$ref": "#/$defs/confirmationEvent" },
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/visualSlot" },
    { "$ref": "#/$defs/imageGeneration" },
    { "$ref": "#/$defs/imageQuality" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "isoDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "stage": {
      "type": "string",
      "enum": [
        "topic-selector",
        "researcher",
        "writer",
        "image-maker",
        "content-assembler",
        "notion-rider",
        "naver-rider"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "passed", "validated", "failed", "blocked", "skipped"]
    },
    "stageExecution": {
      "type": "string",
      "enum": ["not_called", "attempted", "produced", "validated", "aggregated"]
    },
    "mode": {
      "type": "string",
      "const": "formal"
    },
    "visualIntent": {
      "type": "string",
      "enum": ["identify", "explain", "compare", "sequence", "relate", "evidence", "experience", "represent"]
    },
    "assetType": {
      "type": "string",
      "enum": ["official_asset", "portrait_grid", "character_cards", "side_by_side", "timeline", "process_flow", "relationship_map", "official_screenshot", "map", "chart", "original_photo", "generated_illustration", "text_only"]
    },
    "requiredBy": {
      "type": "string",
      "enum": ["title_promise", "reader_question", "evidence", "differentiation", "optional"]
    },
    "sourcePolicy": {
      "type": "string",
      "enum": ["official_or_licensed", "verified_source", "generated_allowed", "no_image"]
    },
    "qualityResult": {
      "type": "string",
      "enum": ["passed", "failed", "blocked", "pending", "skipped", "passed_with_notice", "pending_image-maker", "unavailable"]
    },
    "stageEvent": {
      "type": "object",
      "required": ["event_type", "pipeline_version", "batch_id", "run_id", "topic_id", "stage", "started_at", "ended_at", "status", "attempt"],
      "properties": {
        "event_type": { "enum": ["stage", "lane"] },
        "pipeline_version": { "const": "workflow-optimized-v1" },
        "batch_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "topic_id": { "type": "string", "minLength": 1 },
        "topic_source": { "enum": ["user_defined", "auto_selected"] },
        "stage": { "$ref": "#/$defs/stage" },
        "parent_stage": { "anyOf": [{ "$ref": "#/$defs/stage" }, { "type": "null" }] },
        "lane_id": { "type": ["string", "null"] },
        "worker_role": { "type": "string" },
        "depends_on": { "type": "array", "items": { "$ref": "#/$defs/stage" } },
        "started_at": { "$ref": "#/$defs/isoDateTime" },
        "ended_at": { "$ref": "#/$defs/isoDateTime" },
        "status": { "$ref": "#/$defs/status" },
        "attempt": { "type": "integer", "minimum": 1 },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
        "quality": {
          "type": "object",
          "properties": { "execution": { "$ref": "#/$defs/stageExecution" } },
          "additionalProperties": true
        },
        "error_type": { "type": ["string", "null"] },
        "error_message_safe": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "event_type": { "const": "lane" } } },
          "then": { "required": ["lane_id"], "properties": { "lane_id": { "type": "string", "minLength": 1 } } }
        }
      ],
      "additionalProperties": true
    },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "confirmationEvent": {
      "type": "object",
      "required": ["event_type", "pipeline_version", "run_id", "action", "target_blog_id", "title", "artifact_digest", "requested_at", "confirmed_at", "actor"],
      "properties": {
        "event_type": { "const": "confirmation" },
        "pipeline_version": { "const": "workflow-optimized-v1" },
        "run_id": { "type": "string", "minLength": 1 },
        "action": { "const": "naver-draft-save" },
        "target_blog_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "artifact_digest": { "$ref": "#/$defs/artifactDigest" },
        "confirmation_request_digest": { "$ref": "#/$defs/sha256" },
        "requested_at": { "$ref": "#/$defs/isoDateTime" },
        "confirmed_at": { "$ref": "#/$defs/isoDateTime" },
        "actor": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "manifestFile": {
      "type": "object",
      "required": ["role", "path", "order", "size_bytes", "sha256"],
      "properties": {
        "role": { "enum": ["final_markdown", "naver_layout", "naver_copy", "naver_input", "image_map", "body_image", "thumbnail"] },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+" },
        "order": { "type": "integer", "minimum": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": ["schema_version", "pipeline_version", "run_id", "topic_id", "mode", "created_at", "files", "artifact_digest"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "pipeline_version": { "const": "workflow-optimized-v1" },
        "run_id": { "type": "string", "minLength": 1 },
        "topic_id": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/mode" },
        "created_at": { "$ref": "#/$defs/isoDateTime" },
        "files": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/manifestFile" }, "uniqueItems": true },
        "artifact_digest": { "$ref": "#/$defs/artifactDigest" }
      },
      "allOf": [
        { "contains": { "properties": { "role": { "const": "final_markdown" } }, "required": ["role"] } },
        { "contains": { "properties": { "role": { "const": "naver_layout" } }, "required": ["role"] } },
        { "contains": { "properties": { "role": { "const": "naver_copy" } }, "required": ["role"] } },
        { "contains": { "properties": { "role": { "const": "naver_input" } }, "required": ["role"] } },
        { "contains": { "properties": { "role": { "const": "image_map" } }, "required": ["role"] } },
        { "contains": { "properties": { "role": { "const": "thumbnail" } }, "required": ["role"] } }
      ],
      "additionalProperties": false
    },
    "visualSlot": {
      "type": "object",
      "required": ["visual_slot_id", "visual_intent", "asset_type", "required_by", "source_policy", "subject_scope", "section", "fallback"],
      "properties": {
        "visual_slot_id": { "type": "string", "pattern": "^(VIS|TH|THUMB)-[A-Za-z0-9_-]+$" },
        "visual_intent": { "$ref": "#/$defs/visualIntent" },
        "asset_type": { "$ref": "#/$defs/assetType" },
        "required_by": { "$ref": "#/$defs/requiredBy" },
        "source_policy": { "$ref": "#/$defs/sourcePolicy" },
        "subject_scope": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 },
        "fallback": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "imageGeneration": {
      "type": "object",
      "required": ["generation_provider", "generation_model", "generation_snapshot", "generation_control", "quality", "size", "prompt_template_version", "prompt_sha256", "reference_sha256", "output_sha256", "generated_at", "provenance_status", "output_path"],
      "properties": {
        "production_method": { "enum": ["ai_generation", "local_render"] },
        "generation_provider": { "type": "string", "minLength": 1 },
        "generation_model": { "type": "string", "minLength": 1 },
        "generation_snapshot": { "type": "string", "minLength": 1 },
        "generation_control": { "enum": ["locked", "unlocked", "unavailable"] },
        "quality": { "type": "string", "enum": ["high"] },
        "size": { "type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$" },
        "prompt_template_version": { "type": "string", "minLength": 1 },
        "prompt_sha256": { "$ref": "#/$defs/artifactDigest" },
        "reference_sha256": { "type": "array", "items": { "$ref": "#/$defs/artifactDigest" } },
        "output_sha256": { "$ref": "#/$defs/artifactDigest" },
        "generated_at": { "$ref": "#/$defs/isoDateTime" },
        "provenance_status": { "enum": ["generated", "official", "licensed", "captured"] },
        "renderer_version": { "type": "string", "minLength": 1 },
        "renderer_sha256": { "$ref": "#/$defs/artifactDigest" },
        "input_sha256": { "$ref": "#/$defs/artifactDigest" },
        "output_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" }
      },
      "additionalProperties": false
    },
    "imageQuality": {
      "type": "object",
      "required": ["image_sha256", "automated_checks", "scores", "immediate_failure", "mobile_rendered", "mobile_viewport", "mobile_render_path", "mobile_render_sha256", "human_verdict"],
      "properties": {
        "image_sha256": { "$ref": "#/$defs/artifactDigest" },
        "automated_checks": {
          "type": "object",
          "required": ["decode_check", "duplicate_check", "ocr_check", "visual_contract_check", "mobile_render_check"],
          "properties": {
            "decode_check": { "const": "passed" },
            "duplicate_check": { "const": "passed" },
            "ocr_check": { "const": "passed" },
            "visual_contract_check": { "const": "passed" },
            "mobile_render_check": { "const": "passed" }
          },
          "additionalProperties": true
        },
        "scores": {
          "type": "object",
          "required": ["subject_relevance", "composition_legibility", "rendering_completion", "information_contribution", "style_consistency"],
          "properties": {
            "subject_relevance": { "type": "integer", "minimum": 0, "maximum": 4 },
            "composition_legibility": { "type": "integer", "minimum": 0, "maximum": 4 },
            "rendering_completion": { "type": "integer", "minimum": 0, "maximum": 4 },
            "information_contribution": { "type": "integer", "minimum": 0, "maximum": 4 },
            "style_consistency": { "type": "integer", "minimum": 0, "maximum": 4 }
          },
          "additionalProperties": true
        },
        "immediate_failure": { "const": false },
        "mobile_rendered": { "const": true },
        "mobile_viewport": { "const": "390x844" },
        "mobile_render_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
        "mobile_render_sha256": { "$ref": "#/$defs/artifactDigest" },
        "human_verdict": { "const": "passed" }
      },
      "additionalProperties": true
    }
  }
}
