{
  "description": "Block Notion and Naver external writes unless the workflow verifier confirms the current approval and artifact digest.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(mcp__.*|browser.*|computer.*|chrome.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"/Users/beomseok/00_AI/01_ NAVER_BLOG_AUTOMATE\" && /Users/beomseok/00_AI/01_ NAVER_BLOG_AUTOMATE/.venv/bin/python3 -m tools.workflow_verifier hook",
            "timeout": 30,
            "statusMessage": "Checking workflow external-write Gate"
          }
        ]
      }
    ]
  }
}
